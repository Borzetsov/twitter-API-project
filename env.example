# 1. Необходимо создать свой файл ".env.local" в корне проекта (где и pom.xml)
# 2. Проверить, что файл ".env.local" включен в .gitignore
# 3. В файле ".env" необходимо указать следующие переменные окружения:
SPRING_DATASOURCE_NAME=postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secret_password_here
# Base64-encoded secret containing at least 32 random bytes (HS256)
JWT_SECRET=replace_with_a_base64_encoded_secret